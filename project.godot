; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="ecorescuertest01"
run/main_scene="uid://c3p4nqksuogc5"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://Misc/AppIcon/icon_1024.png"
boot_splash/bg_color=Color(0.0627, 0.149, 0.18, 1)
boot_splash/show_image=false

[autoload]

Global="*res://Misc/Globals/Code/globals.gd"
MusicManager="*res://Audio/Music_Levels/MusicManager.gd"
SettingsManager="*res://Audio/settings_manager.gd"
SFXManager="*res://Audio/SFX/SFXManager.gd"
LevelManager="*res://LevelManager.gd"
SilentWolf="*res://silent_wolf/SilentWolf.gd"
Story="*res://Misc/Story/story.gd"
Progress="*res://Misc/Progress/progress.gd"
TouchControls="*res://Misc/TouchControls/touch_controls.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[dotnet]

project/assembly_name="ecorescuertest01"

[editor]

version_control/plugin_name="GitPlugin"
version_control/autoload_on_startup=true

[file_customization]

folder_colors={
"res://Levels/Ai DataCenter_level/Assets/": "teal",
"res://Levels/Ai DataCenter_level/Assets/Bullets/": "yellow",
"res://Levels/Ai DataCenter_level/Assets/Scripts/": "gray",
"res://Levels/Ai DataCenter_level/Assets/Sounds/": "purple",
"res://Levels/Ai DataCenter_level/Assets/Sprites/": "blue",
"res://Levels/Ai DataCenter_level/Assets/Turrets/": "red",
"res://_folder_structure_placeholder/": "gray",
"res://addons/": "gray"
}

